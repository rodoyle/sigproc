# Cline Ignore - Rust Project Configuration

# Build and release artifacts (generated by cargo)
/target
build/
debug/
release/

# Cargo lock file (optional - typically generated, but can be tracked)
Cargo.lock

# IDE specific folders (if not needed in version control)
.idea/
.vscode/settings.json
*.iml

# Editor swap and backup files
*~
.swp
.swo

# OS specific files
.DS_Store
Thumbs.db
.AppleDouble

# Temporary files
tmp/
temp/
.cache/
.vscode-test-results/

# Test coverage reports (if generated)
*.profraw
*.profdata
coverage/

# Environment variables file (optional - sensitive data)
.env

# Log files (can be large and non-version-controlled)
logs/*.log

# Generated documentation (typically in docs folder, but can be excluded)
target/doc/
target/c-api/